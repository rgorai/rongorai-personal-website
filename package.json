{
  "name": "rongorai-personal-website",
  "version": "1.0.0",
  "description": "Ron Gorai's personal website",
  "repository": "https://github.com/rgorai/rongorai-personal-website.git",
  "author": "Ron Gorai - rgorai",
  "license": "ISC",
  "homepage": "https://www.rongorai.com",
  "main": "dist/server/index.js",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node dist/server/index.js",
    "start-watch": "nodemon --ext ts --exec tsx server/index.ts",
    "build": "yarn build:client && yarn build:server",
    "build:client": "yarn --cwd client build",
    "build:server": "tsc -p server/tsconfig.json",
    "dev": "concurrently \"yarn start-watch\" \"yarn --cwd client dev\"",
    "heroku-postbuild": "yarn --cwd client install && yarn build",
    "precommit": "lint-staged",
    "seed": "tsx server/tasks/seed.ts",
    "prepare": "husky install && chmod ug+x .husky/*",
    "typecheck": "yarn typecheck:client && yarn typecheck:server",
    "typecheck:client": "yarn --cwd client tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "compress-images": "bash scripts/compress-images.sh",
    "s3:diff": "aws s3 sync .local/s3-bucket/ s3://rongorai-personal-website-bucket/ --exclude '*.DS_Store' --dryrun",
    "s3:sync": "aws s3 sync .local/s3-bucket/ s3://rongorai-personal-website-bucket/ --exclude '*.DS_Store'"
  },
  "eslintConfig": {
    "extends": "@rgorai/eslint-config/.eslintrc"
  },
  "prettier": "@rgorai/eslint-config/.prettierrc.js",
  "stylelint": {
    "extends": "@rgorai/eslint-config/.stylelintrc"
  },
  "lint-staged": {
    "*": "yarn lint"
  },
  "dependencies": {
    "aws-sdk": "^2.1319.0",
    "classnames": "^2.3.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.17.2",
    "mongodb": "^5.0.1",
    "nodemailer": "^6.7.5",
    "openai": "^6.16.0",
    "path": "^0.12.7"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.16.5",
    "@rgorai/eslint-config": "^1.1.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4",
    "@types/node": "^25.3.0",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^5.59.2",
    "@typescript-eslint/parser": "^5.59.2",
    "concurrently": "^7.6.0",
    "eslint": "^8.39.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.1.2",
    "nodemon": "^2.0.15",
    "prettier": "^2.8.8",
    "stylelint": "^15.6.1",
    "stylelint-config-standard-scss": "^9.0.0",
    "stylelint-prettier": "^3.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.5.4"
  }
}